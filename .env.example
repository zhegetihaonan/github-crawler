# GitHub API token(s), comma separated. Keep real tokens in .env only.
GITHUB_TOKEN=
GITLAB_TOKEN=
API_KEY=
MAX_TASK_ATTEMPTS=5
MAX_RESULT_ATTEMPTS=8

# Service endpoints. These hostnames work only when matching services share a Docker network.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# Callback URLs consumed by result_worker and crawler_status.
REPORT_URL=
REPORT_URL_GITHUB=
REPORT_URL_WENKU=
STATUS_URL=

# MySQL task database. The `tasks` table must be created separately.
MYSQL_USER=crawler
MYSQL_PWD=replace_me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=github_crawler
RESULTS_DB_ENABLED=1
RESULTS_TABLE=crawler_results

# MinIO/S3-compatible storage. Leave blank only if result uploads are not required.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_GITHUB=
MINIO_BUCKET_WENKU=

# Optional GitLab and API overrides.
GITLAB_URL=https://gitlab.com
GITHUB_URL=https://api.github.com

# Worker behavior.
LOG_LEVEL=INFO
GITHUB_SLEEP=2.0
GITLAB_SLEEP=2.0
SINCE_DATE_DAYS=180
SFTP_FLAG=0
THREAD_NUM=1
ENABLE_WENKU_CRAWLER=0
IP=
PROXY_URL=

# Queue names; keep consistent across dispatcher and workers.
TASK_QUEUE=mw_task_queue
TASK_EXCHANGE=task.exchange
RESULT_EXCHANGE=result.exchange
QUEUE_GITHUB=crawler.task.github
QUEUE_WENKU=crawler.task.wenku
QUEUE_RESULT=crawler.result
